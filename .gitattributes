# Auto detect text files and perform LF normalization
* text=auto

# Large binary/data assets via Git LFS
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.jsonl filter=lfs diff=lfs merge=lfs -text
tokenizer.json filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.db-wal filter=lfs diff=lfs merge=lfs -text
*.db-shm filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
bundles/*.zip filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text

# Reply dumps under output/v87_measurements are evidence receipts, 150-190 KB
# each, and belong in git proper. The *.jsonl LFS rule above was written for
# multi-gigabyte corpora under datasets/, which still go to LFS.
output/v87_measurements/*.jsonl -filter -diff -merge text

# Neurogenesis event logs (v93) are ~10 KB receipts, not corpora: git proper.
output/*/neurogenesis.jsonl -filter -diff -merge text
